    {
      "name": "01 - Autenticación (elegir un rol)",
      "item": [
        {
          "name": "Login administrador (guarda JWT en entorno)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Endpoint: POST /api/v1/auth/login. Verificar autorización por rol. No ejecutar mutaciones sin entorno de prueba.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo_admin}}\",\n  \"password\": \"{{clave_admin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Respuesta HTTP esperada (200)\", function () { pm.expect([200]).to.include(pm.response.code); });",
                  "if(pm.response.code===200){const data=pm.response.json(); if(data.token){pm.environment.set('token', data.token); pm.environment.set('rolActual', data.rol || '');}}"
                ]
              }
            }
          ]
        },
